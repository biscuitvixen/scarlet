# Discord bot token from https://discord.com/developers/applications
# The bot needs the "message content" privileged intent enabled.
DISCORD_TOKEN=

# Optional. If set, slash commands sync to this guild instantly instead of
# taking up to an hour to propagate globally. Handy while developing.
GUILD_ID=

# INFO logs what she did with each message she looked at. DEBUG adds the
# step by step of the time parsing: what dateparser made of the text, and
# which rule dropped each candidate. Reach for it when she has gone quiet
# and the logs show nothing wrong. Applies to her own loggers only, since
# discord.py at DEBUG prints every gateway frame and buries the rest.
LOG_LEVEL=INFO

# The build she shows on her profile and in /version: the commit and its
# date, baked into the image by CI. Set them by hand only if you want a run
# from a local checkout to name its commit.
# GIT_SHA=
# GIT_DATE=

# The first line of her profile. The running build goes underneath it at
# login, so edit it here rather than on Discord, where it gets rewritten.
BOT_ABOUT=I may not be real - but I am still fluffy!

# Set false to drop the music cog and never contact Lavalink. Worth doing
# when running the bot outside compose, where an unreachable node retries
# forever and drowns out every other log line.
MUSIC_ENABLED=true

# Lavalink audio server. Password must match lavalink/application.yml.
LAVALINK_URL=http://lavalink:2333
LAVALINK_PASSWORD=youshallnotpass

# Seconds she stays in a voice channel with nothing playing before leaving
# on her own. She also leaves immediately if the channel empties.
MUSIC_IDLE_TIMEOUT=300

# YouTube OAuth refresh token for Lavalink's youtube-source plugin, the fix
# for "sign in to confirm you're not a bot" errors. Leave blank the first
# time: Lavalink logs a device-link URL and code, authorise with a BURNER
# google account (never your main one), then paste the refresh token it logs
# here. See the music setup notes in the README.
YOUTUBE_OAUTH_REFRESH_TOKEN=
